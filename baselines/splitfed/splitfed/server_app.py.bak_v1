#!/usr/bin/env python3
"""
patch_server_v2.py — fixes "Skipping round N: no evaluation results"
Run from: /lustre/hdd/LAS/jannesar-lab/aadishah/flower_bench/baselines/splitfed
Usage:    python patch_server_v2.py
"""
import os, sys

TARGET = "splitfed/server_app.py"

NEW_CONTENT = '''\
import os
import csv
import time
from typing import List, Tuple

import pandas as pd
from flwr.common import Context, Metrics, ndarrays_to_parameters, parameters_to_ndarrays
from flwr.server import ServerApp, ServerAppComponents, ServerConfig
from flwr.server.strategy import FedAvg

from splitfed.task import SplitFedResNet10, get_parameters


def arrays_size_mb(arrays):
    total = 0
    for arr in arrays:
        if hasattr(arr, "nbytes"):
            total += arr.nbytes
        elif hasattr(arr, "numel") and hasattr(arr, "element_size"):
            total += arr.numel() * arr.element_size()
    return total / (1024 * 1024)


def weighted_average(metrics: List[Tuple[int, Metrics]]) -> Metrics:
    total_examples = sum(num_examples for num_examples, _ in metrics)
    accuracy = sum(num_examples * m.get("accuracy", 0.0) for num_examples, m in metrics) / total_examples
    return {"accuracy": accuracy}


def weighted_fit_average(results):
    total_examples = sum(fit_res.num_examples for _, fit_res in results)
    train_loss = sum(
        fit_res.num_examples * fit_res.metrics.get("train_loss", 0.0)
        for _, fit_res in results
    ) / total_examples
    train_acc = sum(
        fit_res.num_examples * fit_res.metrics.get("train_accuracy", 0.0)
        for _, fit_res in results
    ) / total_examples
    return train_loss, train_acc


class CsvFedAvg(FedAvg):
    def __init__(self, method_name: str, csv_path: str, batch_size: int, local_epochs: int, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.method_name = method_name
        self.csv_path = csv_path
        self.batch_size = batch_size
        self.local_epochs = local_epochs
        self.fit_cache = {}
        self.round_stats = {}
        self.written_rounds = set()          # guard: never write same round twice
        self.cumulative_total_comm_mb = 0.0
        self.cumulative_round_wall_time_sec = 0.0

        self.csv_fieldnames = [
            "method", "dataset", "model", "round",
            "train_loss", "train_accuracy", "test_loss", "test_accuracy",
            "num_fit_clients", "fit_failures",
            "fit_param_down_mb", "fit_param_up_mb", "fit_param_total_comm_mb",
            "split_train_smashed_forward_mb", "split_train_smashed_backward_mb",
            "split_train_label_mb", "split_train_total_comm_mb",
            "fit_total_comm_mb",
            "client_train_time_mean_sec", "client_train_time_max_sec",
            "fit_total_time_mean_sec", "fit_total_time_max_sec", "fit_wall_time_sec",
            "num_eval_clients", "eval_failures",
            "eval_param_down_mb", "eval_param_up_mb", "eval_param_total_comm_mb",
            "split_eval_smashed_forward_mb", "split_eval_label_mb", "split_eval_total_comm_mb",
            "eval_total_comm_mb",
            "client_eval_time_mean_sec", "client_eval_time_max_sec",
            "eval_total_time_mean_sec", "eval_total_time_max_sec", "eval_wall_time_sec",
            "round_param_comm_mb", "round_splitfed_comm_mb", "round_total_comm_mb",
            "cumulative_total_comm_mb", "round_wall_time_sec", "cumulative_round_wall_time_sec",
        ]

        os.makedirs(os.path.dirname(csv_path), exist_ok=True)
        with open(self.csv_path, "w", newline="") as f:
            writer = csv.DictWriter(f, fieldnames=self.csv_fieldnames)
            writer.writeheader()

    def _init_round(self, server_round, round_start=None):
        if server_round not in self.round_stats:
            self.round_stats[server_round] = {
                "round_start_time": round_start or time.perf_counter(),
                "fit_param_down_mb": 0.0, "fit_param_up_mb": 0.0,
                "fit_param_total_comm_mb": 0.0, "fit_total_comm_mb": 0.0,
                "fit_wall_time_sec": 0.0,
                "num_fit_clients": 0, "fit_failures": 0,
                "client_train_times": [], "client_fit_total_times": [],
                "train_loss": 0.0, "train_accuracy": 0.0,
                "num_eval_clients": 0, "eval_failures": 0,
                "eval_param_down_mb": 0.0, "eval_param_up_mb": 0.0,
                "eval_param_total_comm_mb": 0.0,
                "eval_wall_time_sec": 0.0, "client_eval_times": [],
                "split_train_smashed_forward_mb": 0.0,
                "split_train_smashed_backward_mb": 0.0,
                "split_train_label_mb": 0.0,
                "split_train_total_comm_mb": 0.0,
                "split_eval_smashed_forward_mb": 0.0,
                "split_eval_label_mb": 0.0,
                "split_eval_total_comm_mb": 0.0,
                "test_loss": 0.0, "test_accuracy": 0.0,
            }

    def configure_fit(self, server_round, parameters, client_manager):
        round_start = time.perf_counter()
        fit_ins_list = super().configure_fit(server_round, parameters, client_manager)
        self._init_round(server_round, round_start)
        param_down_per_client_mb = arrays_size_mb(parameters_to_ndarrays(parameters))
        self.round_stats[server_round]["fit_param_down_mb"] = param_down_per_client_mb * len(fit_ins_list)
        self.round_stats[server_round]["num_fit_clients"] = len(fit_ins_list)
        return fit_ins_list

    def configure_evaluate(self, server_round, parameters, client_manager):
        eval_ins_list = super().configure_evaluate(server_round, parameters, client_manager)
        self._init_round(server_round)
        param_down_per_client_mb = arrays_size_mb(parameters_to_ndarrays(parameters))
        self.round_stats[server_round]["num_eval_clients"] = len(eval_ins_list)
        self.round_stats[server_round]["eval_param_down_mb"] = param_down_per_client_mb * len(eval_ins_list)
        return eval_ins_list

    def aggregate_fit(self, server_round, results, failures):
        fit_start = time.perf_counter()
        parameters_aggregated, metrics_aggregated = super().aggregate_fit(server_round, results, failures)
        self._init_round(server_round)
        stats = self.round_stats[server_round]
        stats["num_fit_clients"] = len(results)
        stats["fit_failures"] = len(failures)

        fit_param_up_mb = 0.0
        client_train_times, client_fit_total_times = [], []
        total_smashed_fwd = total_smashed_bwd = total_label = 0.0

        for _, fit_res in results:
            fit_param_up_mb += arrays_size_mb(parameters_to_ndarrays(fit_res.parameters))
            m = fit_res.metrics
            if "client_train_time_sec" in m:
                client_train_times.append(float(m["client_train_time_sec"]))
            if "client_fit_total_time_sec" in m:
                client_fit_total_times.append(float(m["client_fit_total_time_sec"]))
            total_smashed_fwd += float(m.get("smashed_forward_mb", 0.0))
            total_smashed_bwd += float(m.get("smashed_backward_mb", 0.0))
            total_label       += float(m.get("label_mb", 0.0))

        stats["fit_param_up_mb"] = fit_param_up_mb
        stats["client_train_times"] = client_train_times
        stats["client_fit_total_times"] = client_fit_total_times
        stats["split_train_smashed_forward_mb"]  = total_smashed_fwd
        stats["split_train_smashed_backward_mb"] = total_smashed_bwd
        stats["split_train_label_mb"]            = total_label
        stats["split_train_total_comm_mb"]       = total_smashed_fwd + total_smashed_bwd + total_label

        down_mb = float(stats.get("fit_param_down_mb", 0.0))
        stats["fit_param_total_comm_mb"] = down_mb + fit_param_up_mb
        stats["fit_total_comm_mb"] = down_mb + fit_param_up_mb + stats["split_train_total_comm_mb"]
        stats["fit_wall_time_sec"] = time.perf_counter() - stats.get("round_start_time", fit_start)

        if results:
            train_loss, train_acc = weighted_fit_average(results)
            self.fit_cache[server_round] = {"train_loss": train_loss, "train_accuracy": train_acc}
            stats["train_loss"] = train_loss
            stats["train_accuracy"] = train_acc

        return parameters_aggregated, metrics_aggregated

    def aggregate_evaluate(self, server_round, results, failures):
        eval_start = time.perf_counter()
        loss_aggregated, metrics_aggregated = super().aggregate_evaluate(server_round, results, failures)
        self._init_round(server_round)
        stats = self.round_stats[server_round]
        stats["eval_failures"] = len(failures)
        stats["eval_wall_time_sec"] = time.perf_counter() - eval_start

        client_eval_times = []
        eval_param_up_mb = 0.0
        total_eval_smashed_fwd = total_eval_label = 0.0

        for _, evaluate_res in results:
            m = evaluate_res.metrics
            if "client_eval_time_sec" in m:
                client_eval_times.append(float(m["client_eval_time_sec"]))
            eval_param_up_mb       += float(m.get("eval_param_up_mb", 0.0))
            total_eval_smashed_fwd += float(m.get("eval_smashed_forward_mb", 0.0))
            total_eval_label       += float(m.get("eval_label_mb", 0.0))

        stats["client_eval_times"] = client_eval_times
        stats["eval_param_up_mb"] = eval_param_up_mb
        stats["split_eval_smashed_forward_mb"] = total_eval_smashed_fwd
        stats["split_eval_label_mb"]           = total_eval_label
        stats["split_eval_total_comm_mb"]      = total_eval_smashed_fwd + total_eval_label
        stats["eval_param_total_comm_mb"] = float(stats.get("eval_param_down_mb", 0.0)) + eval_param_up_mb

        # Store test metrics even if results is empty (use 0.0 as fallback)
        if results and loss_aggregated is not None:
            stats["test_loss"] = float(loss_aggregated)
            stats["test_accuracy"] = float(metrics_aggregated.get("accuracy", 0.0)) if metrics_aggregated else 0.0
        else:
            print(f"[CSV] Round {server_round}: eval returned {len(results)} results, "
                  f"{len(failures)} failures — writing row with available data")

        fit_metrics = self.fit_cache.get(server_round, {})

        # Always write the row — even if eval was empty we still have train metrics
        self._write_round_csv_row(
            server_round=server_round,
            train_loss=float(fit_metrics.get("train_loss", stats.get("train_loss", 0.0))),
            train_accuracy=float(fit_metrics.get("train_accuracy", stats.get("train_accuracy", 0.0))),
            test_loss=float(stats.get("test_loss", 0.0)),
            test_accuracy=float(stats.get("test_accuracy", 0.0)),
        )

        return loss_aggregated, metrics_aggregated

    def _write_round_csv_row(self, server_round, train_loss, train_accuracy, test_loss, test_accuracy):
        # Guard: never write the same round twice
        if server_round in self.written_rounds:
            print(f"[CSV] Round {server_round} already written, skipping duplicate")
            return
        self.written_rounds.add(server_round)

        stats = self.round_stats.get(server_round, {})
        round_wall_time_sec = (
            time.perf_counter() - stats["round_start_time"] if "round_start_time" in stats else 0.0
        )
        self.cumulative_round_wall_time_sec += round_wall_time_sec

        fit_param_down_mb        = float(stats.get("fit_param_down_mb", 0.0))
        fit_param_up_mb          = float(stats.get("fit_param_up_mb", 0.0))
        fit_param_total_comm_mb  = fit_param_down_mb + fit_param_up_mb
        eval_param_down_mb       = float(stats.get("eval_param_down_mb", 0.0))
        eval_param_up_mb         = float(stats.get("eval_param_up_mb", 0.0))
        eval_param_total_comm_mb = eval_param_down_mb + eval_param_up_mb

        split_train_fwd = float(stats.get("split_train_smashed_forward_mb", 0.0))
        split_train_bwd = float(stats.get("split_train_smashed_backward_mb", 0.0))
        split_train_lbl = float(stats.get("split_train_label_mb", 0.0))
        split_train_tot = split_train_fwd + split_train_bwd + split_train_lbl
        split_eval_fwd  = float(stats.get("split_eval_smashed_forward_mb", 0.0))
        split_eval_lbl  = float(stats.get("split_eval_label_mb", 0.0))
        split_eval_tot  = split_eval_fwd + split_eval_lbl

        round_splitfed_comm_mb = split_train_tot + split_eval_tot
        round_param_comm_mb    = fit_param_total_comm_mb + eval_param_total_comm_mb
        round_total_comm_mb    = round_param_comm_mb + round_splitfed_comm_mb
        self.cumulative_total_comm_mb += round_total_comm_mb

        def safe_mean(lst): return sum(lst) / len(lst) if lst else 0.0
        def safe_max(lst):  return max(lst) if lst else 0.0

        ct  = stats.get("client_train_times", [])
        cft = stats.get("client_fit_total_times", [])
        ce  = stats.get("client_eval_times", [])

        row = {
            "method": self.method_name, "dataset": "CIFAR10", "model": "ResNet10",
            "round": server_round,
            "train_loss": train_loss, "train_accuracy": train_accuracy,
            "test_loss": test_loss,   "test_accuracy": test_accuracy,
            "num_fit_clients": int(stats.get("num_fit_clients", 0)),
            "fit_failures":    int(stats.get("fit_failures", 0)),
            "fit_param_down_mb": fit_param_down_mb,
            "fit_param_up_mb":   fit_param_up_mb,
            "fit_param_total_comm_mb": fit_param_total_comm_mb,
            "split_train_smashed_forward_mb":  split_train_fwd,
            "split_train_smashed_backward_mb": split_train_bwd,
            "split_train_label_mb":            split_train_lbl,
            "split_train_total_comm_mb":       split_train_tot,
            "fit_total_comm_mb": float(stats.get("fit_total_comm_mb", fit_param_total_comm_mb)),
            "client_train_time_mean_sec": safe_mean(ct),
            "client_train_time_max_sec":  safe_max(ct),
            "fit_total_time_mean_sec":    safe_mean(cft),
            "fit_total_time_max_sec":     safe_max(cft),
            "fit_wall_time_sec": float(stats.get("fit_wall_time_sec", 0.0)),
            "num_eval_clients": int(stats.get("num_eval_clients", 0)),
            "eval_failures":    int(stats.get("eval_failures", 0)),
            "eval_param_down_mb": eval_param_down_mb,
            "eval_param_up_mb":   eval_param_up_mb,
            "eval_param_total_comm_mb": eval_param_total_comm_mb,
            "split_eval_smashed_forward_mb": split_eval_fwd,
            "split_eval_label_mb":           split_eval_lbl,
            "split_eval_total_comm_mb":      split_eval_tot,
            "eval_total_comm_mb": eval_param_total_comm_mb + split_eval_tot,
            "client_eval_time_mean_sec": safe_mean(ce),
            "client_eval_time_max_sec":  safe_max(ce),
            "eval_total_time_mean_sec":  safe_mean(ce),
            "eval_total_time_max_sec":   safe_max(ce),
            "eval_wall_time_sec": float(stats.get("eval_wall_time_sec", 0.0)),
            "round_param_comm_mb":    round_param_comm_mb,
            "round_splitfed_comm_mb": round_splitfed_comm_mb,
            "round_total_comm_mb":    round_total_comm_mb,
            "cumulative_total_comm_mb":       self.cumulative_total_comm_mb,
            "round_wall_time_sec":            round_wall_time_sec,
            "cumulative_round_wall_time_sec": self.cumulative_round_wall_time_sec,
        }

        with open(self.csv_path, "a", newline="") as f:
            writer = csv.DictWriter(f, fieldnames=self.csv_fieldnames)
            writer.writerow(row)

        print(f"[CSV] Round {server_round} saved → {self.csv_path}")
        print(row)


def server_fn(context: Context):
    num_rounds        = int(context.run_config["num-server-rounds"])
    num_clients       = int(context.run_config["num-clients"])
    clients_per_round = int(context.run_config.get("clients-per-round", num_clients))
    method_name       = str(context.run_config["method"])
    csv_path          = str(context.run_config["csv-path"])
    batch_size        = int(context.run_config.get("batch-size", 64))
    local_epochs      = int(context.run_config.get("local-epochs", 1))

    model = SplitFedResNet10(num_classes=10)
    initial_parameters = ndarrays_to_parameters(get_parameters(model))

    strategy = CsvFedAvg(
        method_name=method_name,
        csv_path=csv_path,
        batch_size=batch_size,
        local_epochs=local_epochs,
        fraction_fit=clients_per_round / num_clients,
        fraction_evaluate=clients_per_round / num_clients,
        min_fit_clients=clients_per_round,
        min_evaluate_clients=clients_per_round,
        min_available_clients=clients_per_round,
        evaluate_metrics_aggregation_fn=weighted_average,
        initial_parameters=initial_parameters,
    )

    config = ServerConfig(num_rounds=num_rounds)
    return ServerAppComponents(strategy=strategy, config=config)


app = ServerApp(server_fn=server_fn)
'''

if not os.path.isfile(TARGET):
    print(f"ERROR: {TARGET} not found. Are you in the right directory?")
    print(f"       Current dir: {os.getcwd()}")
    sys.exit(1)

backup = TARGET + ".bak_v1"
with open(TARGET) as f:
    original = f.read()
with open(backup, "w") as f:
    f.write(original)
print(f"Backup saved → {backup}")

with open(TARGET, "w") as f:
    f.write(NEW_CONTENT)

print(f"✓ {TARGET} patched successfully (v2)")
